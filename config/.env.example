# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=telescraper

# Telegram Scraper Configuration
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=+201010622257
SOURCE_CHANNEL=muthanapress84

# Telegram Publisher Configuration
TELEGRAM_BOT_TOKEN=
PUBLISH_CHANNEL=@your_publish_channel

# OpenRouter Configuration
OPENROUTER_API_KEY=

# Pipeline Settings
SYNC_INTERVAL_HOURS=2
BATCH_SIZE=50
MAX_RETRY_COUNT=3
RETRY_DELAY_SECONDS=60
CLASSIFICATION_MODEL=deepseek/deepseek-chat-v3-0324:free

# Logging
LOG_LEVEL=INFO

# Bot Settings (for interactive Telegram bot)
ADMIN_USER_IDS=123456789,987654321
BOT_ENABLE_COMMANDS=true
BOT_ENABLE_CALLBACKS=true
